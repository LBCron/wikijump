{
  "name": "framerail",
  "version": "2026.10.27",
  "description": "Framerail - Wikijump frontend service",
  "repository": "https://github.com/Rokurolize/wikijump/tree/develop/framerail",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "private": true,
  "engines": {
    "node": "24.22.1",
    "pnpm": "11.10.0"
  },
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "test": "../scripts/run-browser-test-no-external-network.sh node tests/playwright-runner.js",
    "test:browser-support": "../scripts/run-browser-test-no-external-network.sh node tests/playwright-runner.js --config playwright.browser-support.config.ts",
    "test:unit": "../scripts/run-framerail-unit-tests.sh",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint . && stylelint ./src/**/*.{css,scss,svelte} && tsc -p tsconfig.node-runtime.json",
    "lint:fix": "prettier --write . && eslint . --fix && stylelint ./src/**/*.{css,scss,svelte} --fix",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/accept-language-parser": "^1.5.8",
    "@types/node": "^26.6.4",
    "@types/prismjs": "1.26.6",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "postcss": "^8.5.31",
    "postcss-html": "^2.0.0",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.9.9",
    "prettier-plugin-jsdoc": "^1.8.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-svelte": "^4.1.1",
    "sass": "^1.105.1",
    "stylelint": "^17.16.0",
    "stylelint-config-recess-order": "^7.9.0",
    "stylelint-order": "^8.1.2",
    "stylelint-scss": "^7.3.0",
    "svelte-eslint-parser": "^1.10.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@flatten-js/interval-tree": "^2.0.3",
    "@popperjs/core": "^2.11.8",
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/kit": "^3.1.0",
    "accept-language-parser": "^1.5.0",
    "iconify-icon": "^3.0.4",
    "include-media": "^2.0.0",
    "jquery": "4.0.0",
    "jquery-ui": "1.14.2",
    "json-rpc-2.0": "^1.8.1",
    "prismjs": "1.30.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "svelte-preprocess": "^6.0.5",
    "sveltekit-superforms": "^3.0.0",
    "tippy.js": "^6.3.7",
    "tslib": "^2.8.1",
    "valibot": "^1.5.0"
  }
}
